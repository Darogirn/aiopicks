+    async def _prewarm_artwork(self, *artwork_urls: str | None) -> None:
+        """Issue GET requests against artwork URLs to populate any
+        upstream proxy cache (e.g. AIOMetadata's poster proxy) before
+        the Stremio client requests the asset.
+
+        Each URL is fetched concurrently — but gated by the same
+        semaphore that limits regular metadata requests, so this stays
+        well within the per-minute rate limits of the underlying
+        rating-poster provider.
+
+        Errors of any kind are logged at debug level and otherwise
+        suppressed. This routine MUST NOT raise.
+        """
+
+        tasks = [self._fetch_for_warmup(url) for url in artwork_urls if url]
+        if not tasks:
+            return
+        await asyncio.gather(*tasks, return_exceptions=True)
+
+    async def _fetch_for_warmup(self, url: str) -> None:
+        try:
+            async with self._semaphore:
+                response = await self._client.get(
+                    url, timeout=self._PREWARM_TIMEOUT_SECONDS
+                )
+                # Drain the body so the connection is returned cleanly to
+                # the pool. We don't care about the bytes themselves.
+                await response.aread()
+        except httpx.HTTPError as exc:
+            logger.debug("Pre-warm of %s failed: %s", url, exc)
+

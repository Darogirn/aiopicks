+    async def _fetch_meta_artwork(
+        self, base_url: str, content_type: str, item_id: str
+    ) -> tuple[str | None, str | None]:
+        """Fetch enriched artwork for a known ID via ``/meta/{type}/{id}.json``.
+
+        Stremio's catalog search endpoints commonly return lightweight
+        poster URLs (e.g. raw TMDB CDN images). The richer artwork —
+        RPDB-wrapped posters with rating overlays, Fanart.tv backgrounds,
+        language-aware logos, etc. — lives behind the meta endpoint, which
+        is what Stremio itself queries when rendering a detail page.
+
+        Returns a ``(poster, background)`` tuple. Either value may be
+        ``None``. All errors are swallowed and yield ``(None, None)`` so
+        the caller can fall back to the search-response artwork.
+        """
+
+        if not item_id:
+            return None, None
+
+        url = f"{base_url}/meta/{content_type}/{quote(item_id, safe='')}.json"
+        try:
+            async with self._semaphore:
+                response = await self._client.get(url)
+            response.raise_for_status()
+        except httpx.HTTPError as exc:
+            logger.debug(
+                "Meta lookup for %s on %s failed: %s",
+                item_id,
+                base_url,
+                exc,
+            )
+            return None, None
+
+        try:
+            payload = response.json()
+        except ValueError:
+            return None, None
+
+        meta = payload.get("meta") if isinstance(payload, dict) else None
+        if not isinstance(meta, dict):
+            return None, None
+
+        poster = self._ensure_url(meta.get("poster") or meta.get("thumbnail"))
+        background = self._ensure_url(meta.get("background") or meta.get("fanart"))
+        return poster, background
+

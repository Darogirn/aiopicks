+    async def _resolve_search_catalog_id(
+        self, base_url: str, content_type: str
+    ) -> str:
+        """Discover the search-capable catalog ID by reading the manifest.
+
+        Stremio metadata add-ons declare their catalogs in ``manifest.json``.
+        Each catalog entry has a ``type``, ``id`` and an ``extra`` array
+        listing supported query parameters. To support search we need a
+        catalog of the requested ``type`` whose ``extra`` array contains an
+        entry named ``search``.
+
+        The result is cached per ``(base_url, content_type)`` for the
+        lifetime of the client. If the manifest cannot be fetched or no
+        suitable catalog is found, falls back to ``top`` (Cinemeta's
+        convention), which preserves backwards compatibility.
+        """
+
+        cache_key = (base_url, content_type)
+        cached = self._search_catalog_cache.get(cache_key)
+        if cached is not None:
+            return cached
+
+        async with self._catalog_lookup_lock:
+            cached = self._search_catalog_cache.get(cache_key)
+            if cached is not None:
+                return cached
+
+            catalog_id = self._DEFAULT_SEARCH_CATALOG_ID
+            try:
+                response = await self._client.get(
+                    f"{base_url}/manifest.json", timeout=10.0
+                )
+                response.raise_for_status()
+                manifest = response.json()
+            except httpx.HTTPError as exc:
+                logger.warning(
+                    "Could not fetch metadata add-on manifest from %s: %s; "
+                    "falling back to catalog id '%s'",
+                    base_url,
+                    exc,
+                    catalog_id,
+                )
+                self._search_catalog_cache[cache_key] = catalog_id
+                return catalog_id
+            except ValueError as exc:
+                logger.warning(
+                    "Metadata add-on manifest at %s was not valid JSON: %s; "
+                    "falling back to catalog id '%s'",
+                    base_url,
+                    exc,
+                    catalog_id,
+                )
+                self._search_catalog_cache[cache_key] = catalog_id
+                return catalog_id
+
+            discovered = self._find_search_catalog(manifest, content_type)
+            if discovered is not None:
+                catalog_id = discovered
+                logger.info(
+                    "Discovered search-capable catalog '%s' for type '%s' on %s",
+                    catalog_id,
+                    content_type,
+                    base_url,
+                )
+            else:
+                logger.warning(
+                    "No search-capable catalog declared for type '%s' on %s; "
+                    "falling back to catalog id '%s'",
+                    content_type,
+                    base_url,
+                    catalog_id,
+                )
+
+            self._search_catalog_cache[cache_key] = catalog_id
+            return catalog_id
+
+    @staticmethod
+    def _find_search_catalog(
+        manifest: Any, content_type: str
+    ) -> str | None:
+        """Return the ID of the first catalog in the manifest that matches
+        the requested ``content_type`` and advertises support for the
+        ``search`` extra. Returns ``None`` when no such catalog exists."""
+
+        if not isinstance(manifest, dict):
+            return None
+        catalogs = manifest.get("catalogs")
+        if not isinstance(catalogs, list):
+            return None
+
+        for catalog in catalogs:
+            if not isinstance(catalog, dict):
+                continue
+            if catalog.get("type") != content_type:
+                continue
+            extras = catalog.get("extra") or catalog.get("extraSupported") or []
+            if not isinstance(extras, list):
+                continue
+            extra_names: set[str] = set()
+            for extra in extras:
+                if isinstance(extra, dict):
+                    name = extra.get("name")
+                    if isinstance(name, str):
+                        extra_names.add(name)
+                elif isinstance(extra, str):
+                    extra_names.add(extra)
+            if "search" not in extra_names:
+                continue
+            catalog_id = catalog.get("id")
+            if isinstance(catalog_id, str) and catalog_id:
+                return catalog_id
+
+        return None
+
